<svg
  class="blog-diagram"
  width="800"
  height="490"
  viewBox="0 0 800 490"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="betsToGoalTitle betsToGoalDesc"
>
  <title id="betsToGoalTitle">Bets to goal: a bridge from 100K to 150K units</title>
  <desc id="betsToGoalDesc">Waterfall chart starting from a 100,000-unit baseline. Four planned bets add 12,000, 8,000, 10,000, and 5,000 units for a plan total of 135,000, leaving a 15,000-unit gap below the 150,000-unit goal.</desc>

  <line class="grid-line" x1="60" y1="60" x2="780" y2="60" />
  <line class="grid-line" x1="60" y1="155" x2="780" y2="155" />
  <line class="grid-line" x1="60" y1="250" x2="780" y2="250" />
  <line class="grid-line" x1="60" y1="345" x2="780" y2="345" />
  <line class="baseline" x1="60" y1="440" x2="780" y2="440" />

  <text class="axis" x="52" y="444">0</text>
  <text class="axis" x="52" y="349">40K</text>
  <text class="axis" x="52" y="254">80K</text>
  <text class="axis" x="52" y="159">120K</text>
  <text class="axis" x="52" y="64">160K</text>

  <rect class="bar-anchor" x="80.4" y="202.5" width="62" height="237.5" />
  <rect class="bar-bet" x="183.3" y="174" width="62" height="28.5" />
  <rect class="bar-bet" x="286.1" y="155" width="62" height="19" />
  <rect class="bar-bet" x="389" y="131.3" width="62" height="23.7" />
  <rect class="bar-bet" x="491.9" y="119.4" width="62" height="11.9" />
  <rect class="bar-anchor" x="594.7" y="119.4" width="62" height="320.6" />
  <rect class="bar-gap" x="697.6" y="83.8" width="62" height="35.6" />

  <line class="connector" x1="142.4" y1="202.5" x2="183.3" y2="202.5" />
  <line class="connector" x1="245.3" y1="174" x2="286.1" y2="174" />
  <line class="connector" x1="348.1" y1="155" x2="389" y2="155" />
  <line class="connector" x1="451" y1="131.3" x2="491.9" y2="131.3" />
  <line class="connector" x1="553.9" y1="119.4" x2="594.7" y2="119.4" />
  <line class="connector" x1="656.7" y1="119.4" x2="697.6" y2="119.4" />

  <line class="goal-line" x1="60" y1="83.8" x2="780" y2="83.8" />
  <text class="goal-label" x="66" y="77.5">Goal: 150K</text>

  <text class="val-muted" x="111.4" y="194.5">100K</text>
  <text class="val" x="214.3" y="166">+12K</text>
  <text class="val" x="317.1" y="147">+8K</text>
  <text class="val" x="420" y="123.3">+10K</text>
  <text class="val" x="522.9" y="111.4">+5K</text>
  <text class="val-muted" x="625.7" y="111.4">135K</text>
  <text class="val-accent" x="728.6" y="75.5">15K</text>

  <text class="cat" x="111.4" y="466">Baseline</text>
  <text class="cat" x="214.3" y="466">Promotion</text>
  <text class="cat" x="317.1" y="466">Price tier</text>
  <text class="cat" x="420" y="466">Selection</text>
  <text class="cat" x="522.9" y="466">In-stock</text>
  <text class="cat" x="625.7" y="466">Plan total</text>
  <text class="cat" x="728.6" y="466">Gap to goal</text>
</svg>

<style>
  .blog-diagram {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  .bar-anchor {
    fill: color-mix(in srgb, var(--color-text-muted) 30%, var(--color-bg));
  }

  .bar-bet {
    fill: var(--color-text);
  }

  .bar-gap {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }

  .grid-line {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .baseline {
    stroke: var(--color-text-muted);
    stroke-width: 1;
  }

  .connector {
    stroke: var(--color-text-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .goal-line {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }

  .val,
  .val-muted,
  .val-accent {
    font-size: 13px;
    text-anchor: middle;
  }

  .val,
  .cat {
    fill: var(--color-text);
  }

  .val-muted,
  .axis {
    fill: var(--color-text-muted);
  }

  .val-accent,
  .goal-label {
    fill: var(--color-accent);
  }

  .axis {
    font-size: 12px;
    text-anchor: end;
  }

  .cat {
    font-size: 13px;
    text-anchor: middle;
  }

  .goal-label {
    font-size: 12.5px;
    font-style: italic;
  }
</style>
